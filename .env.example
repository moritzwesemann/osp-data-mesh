# OSP-Data-Mesh – Konfiguration eines Knotens (native Installation)
#
#   cp .env.example .env && chmod 600 .env
#
# Bun liest .env im Arbeitsverzeichnis automatisch (bun run start, bun run cli …).
# Maßgeblich für Namen, Typen und Standardwerte ist src/server/config.ts. Für Docker Compose gibt es
# eine eigene Datei: deploy/.env.example.
#
# Schlüssel erzeugen:  bun run cli gen-key        (oder: openssl rand -base64 32)
# Passwörter erzeugen: openssl rand -hex 24       (nur Hex-Zeichen → ohne Kodierung in URLs nutzbar)
#
# Pflichtangaben sind mit [Pflicht] markiert; alle anderen haben den genannten Standardwert.

# =================================================================================================
# Knoten
# =================================================================================================
# [Pflicht] Kennung des Knotens: Kleinbuchstaben, Ziffern, Bindestrich (2–63 Zeichen).
# Wird beim ersten Start mit dem Knotenschlüssel in der Datenbank gespeichert und ist danach
# unveränderlich (Abweichung → Server startet nicht).
MESH_NODE_ID=osp-beispiel
# [Pflicht] Anzeigename für Partner und Oberfläche
MESH_NODE_NAME=OSP Beispiel
# [Pflicht] Öffentliche Basis-URL dieses Knotens für Partner und Nutzende (in Produktion https://…)
MESH_PUBLIC_URL=https://mesh.osp-beispiel.example.de
# Adresse, auf der der Server lauscht (Standard 127.0.0.1: nur lokal, Caddy davor)
MESH_HOST=127.0.0.1
# Port des Servers (Standard 4401)
MESH_PORT=4401

# =================================================================================================
# Datenbank (Laufzeit)
# =================================================================================================
# [Pflicht] Verbindung des Servers mit der Laufzeitrolle mesh_app (nie mesh_owner!)
MESH_DB_URL=postgres://mesh_app:APP_PASSWORT@127.0.0.1:5432/mesh
# Größe des Verbindungspools (Standard 10, 1–100)
MESH_DB_POOL_MAX=10

# =================================================================================================
# Schlüssel
# =================================================================================================
# [Pflicht] Master-Key (32 Byte, base64) für gespeicherte Geheimnisse: privater Knotenschlüssel,
# Pseudonym-Schlüssel, Zugangsdaten von API-Quellen (AES-256-GCM). Verlust = Geheimnisse unlesbar.
MESH_MASTER_KEY=
# Nur während einer Schlüsselrotation: bisheriger Master-Key (nur zum Entschlüsseln), sonst weglassen
# MESH_MASTER_KEY_PREVIOUS=
# Schlüssel (32 Byte, base64) für Sicherungsdateien (AES-256-GCM). Ohne Schlüssel sind Sicherungen
# deaktiviert. Getrennt vom Master-Key aufbewahren; ohne ihn ist keine Wiederherstellung möglich.
MESH_BACKUP_KEY=

# =================================================================================================
# Sicherungen
# =================================================================================================
# Verzeichnis für Sicherungsdateien *.mbk und Manifeste (Standard ./backups)
MESH_BACKUP_DIR=./backups
# Abstand automatischer Sicherungen in Stunden (Standard 24; 0 = aus; max. 168)
MESH_BACKUP_INTERVAL_HOURS=24
# Anzahl aufbewahrter Sicherungen (Standard 14, 1–365)
MESH_BACKUP_RETENTION=14
# Pfad zu pg_dump (Standard "pg_dump" aus PATH; muss PostgreSQL 18 oder neuer sein)
MESH_PG_DUMP=pg_dump
# Optional (nur Kommandozeile): pg_restore und psql für restore/db-bootstrap; Standard: neben pg_dump,
# sonst aus PATH
# MESH_PG_RESTORE=/usr/lib/postgresql/18/bin/pg_restore
# MESH_PSQL=/usr/lib/postgresql/18/bin/psql

# =================================================================================================
# Anmeldung, Netz, Föderation
# =================================================================================================
# Secure-Flag für Sitzungs-Cookies (Standard true). Nur für eine lokale HTTP-Demo auf false setzen.
MESH_COOKIE_SECURE=true
# Gültigkeit einer Anmeldesitzung in Stunden (Standard 12, 1–72)
MESH_SESSION_TTL_HOURS=12
# http:// für Partneradressen und MESH_PUBLIC_URL erlauben (Standard false; nur lokale Demo/Tests)
MESH_FEDERATION_ALLOW_HTTP=false
# Erlaubte Hosts (host[:port], kommagetrennt) für API-Quellen – Schutz vor SSRF.
# Leer = keine API-Quellen möglich. Beispiel: api.messsystem.example.de,10.0.5.20:8443
MESH_SOURCE_ALLOWED_HOSTS=
# Zugangsgeheimnisse von API-Quellen auch über unverschlüsseltes http:// senden (Standard false).
# Ohne diese Einstellung nur über https:// bzw. an 127.0.0.1, ::1 und localhost. Nur in abgeschotteten Netzen.
MESH_SOURCE_ALLOW_INSECURE_HTTP=false
# X-Forwarded-For auswerten (Standard false). Auf true nur hinter einem vertrauenswürdigen
# Reverse Proxy (Caddy), wenn der Server nicht direkt erreichbar ist (MESH_HOST=127.0.0.1).
MESH_TRUST_PROXY=true

# =================================================================================================
# Betrieb
# =================================================================================================
# Protokollstufe: debug | info | warn | error (Standard info)
MESH_LOG_LEVEL=info
# Zeitzone für Datumsgrenzen von Einwilligungen (Standard Europe/Berlin)
MESH_TIMEZONE=Europe/Berlin
# Verzeichnis der gebauten Web-Oberfläche (Standard ./dist/ui, erzeugt mit bun run build)
MESH_UI_DIR=./dist/ui
# Verzeichnis der gebauten HTML-Dokumentation (Standard ./dist/docs), ausgeliefert unter /hilfe/
MESH_DOCS_DIR=./dist/docs
# Hintergrundaufgaben (Ausgangspostfach, Aufbewahrung, BI-Aktualisierung, Sicherungen) (Standard true)
MESH_WORKERS=true

# =================================================================================================
# BI-Verbindungsdaten zur Anzeige in der Oberfläche (optional, nur Anzeige)
# =================================================================================================
# Adresse, unter der BI-Werkzeuge die Datenbank (Rolle mesh_bi, Schema bi) erreichen
# MESH_BI_DB_HOST=db.osp-beispiel.intern
# MESH_BI_DB_PORT=5432
# MESH_BI_DB_NAME=mesh

# =================================================================================================
# Nur für die Kommandozeile (NICHT in .env, sondern in einer getrennten Datei .env.owner ablegen)
# =================================================================================================
# Der Server-Prozess darf das Owner-Passwort nicht kennen. Bun lädt .env automatisch für jeden
# Prozess; daher diese Werte in .env.owner (chmod 600) ablegen und nur für CLI-Aufrufe laden:
#   bun --env-file=.env --env-file=.env.owner run cli migrate
#
# Verbindung als Schema-Eigentümer mesh_owner (migrate, restore, rotate-master-key)
# MESH_DB_OWNER_URL=postgres://mesh_owner:OWNER_PASSWORT@127.0.0.1:5432/mesh
# Passwörter der drei Rollen für "bun run cli db-bootstrap --superuser-url …"
# MESH_DB_OWNER_PASSWORD=
# MESH_DB_APP_PASSWORD=
# MESH_DB_BI_PASSWORD=
# Optional für "bun run cli create-admin": vorgegebenes Erstpasswort (sonst erzeugt und einmalig
# ausgegeben; ein erzeugtes Passwort muss bei der ersten Anmeldung geändert werden)
# MESH_ADMIN_PASSWORD=
