# OSP-Data-Mesh – Umgebungsdatei für Docker Compose (deploy/docker-compose.yml)
#
#   cp .env.example .env && chmod 600 .env     (im Verzeichnis deploy/)
#
# Diese Datei wird von Docker Compose nur zum Einsetzen der Variablen in docker-compose.yml gelesen.
# Jeder Dienst erhält ausschließlich die für ihn bestimmten Werte (der Knoten z. B. nie das
# Owner-Passwort). Die vollständige Beschreibung aller MESH_*-Variablen steht in ../.env.example.
#
# Schlüssel und Passwörter erzeugen (je Wert einmal ausführen, nie Beispielwerte übernehmen):
#   Schlüssel (32 Byte, base64):  openssl rand -base64 32      (gleichwertig: bun run cli gen-key)
#   Passwörter (nur Hex-Zeichen, damit sie ohne Kodierung in Verbindungs-URLs passen):
#                                 openssl rand -hex 24
#
# Alle Werte gehören in die Passwortverwaltung des OSP. Ohne MESH_MASTER_KEY sind die
# gespeicherten Geheimnisse (Knotenschlüssel, API-Zugangsdaten) nicht mehr lesbar; ohne
# MESH_BACKUP_KEY sind die Sicherungen nicht wiederherstellbar.

# --- Knoten -------------------------------------------------------------------------------------
# Kennung des Knotens (klein, a-z, 0-9, Bindestrich; nach dem ersten Start unveränderlich)
MESH_NODE_ID=osp-beispiel
# Anzeigename für Partner und Oberfläche
MESH_NODE_NAME=OSP Beispiel
# Öffentliche Adresse, unter der Partner und Nutzende den Knoten erreichen (https://<CADDY_DOMAIN>)
MESH_PUBLIC_URL=https://mesh.osp-beispiel.example.de

# --- TLS (Caddy) --------------------------------------------------------------------------------
# DNS-Name des Knotens; muss zu MESH_PUBLIC_URL passen
CADDY_DOMAIN=mesh.osp-beispiel.example.de
# "internal" = eigene CA von Caddy (LAN/Test); E-Mail-Adresse = automatisches HTTPS per ACME
# (z. B. CADDY_TLS=it@osp-beispiel.example.de; Ports 80/443 müssen aus dem Internet erreichbar sein)
# Test/LAN mit "internal": Clients und Partnerknoten müssen Caddys Wurzelzertifikat vertrauen
# (docs/installation.md, "Prüfen"). Für einen Test auf einem Rechner ohne DNS-Eintrag eignet sich ein Name
# unter .localhost (z. B. CADDY_DOMAIN=mesh.localhost, MESH_PUBLIC_URL=https://mesh.localhost:8443) –
# Browser und curl lösen ihn ohne DNS zu 127.0.0.1 auf. Nicht für den Austausch mit Partnerknoten: Bun
# verbindet *.localhost immer mit der eigenen Loopback-Adresse; Partner brauchen einen echten DNS-Namen.
CADDY_TLS=internal
# Netzwerkschnittstelle, auf der Caddy seine Ports veröffentlicht (Standard: alle),
# z. B. nur die LAN-Adresse des Servers (für einen Test nur auf diesem Rechner: 127.0.0.1)
CADDY_BIND=0.0.0.0
# Ports für HTTPS und HTTP (Weiterleitung auf HTTPS). Produktiv 443 und 80 – ACME (CADDY_TLS mit
# E-Mail-Adresse) funktioniert nur damit. Abweichende Ports nur mit CADDY_TLS=internal bzw. eigenem
# Zertifikat, z. B. wenn 80/443 auf dem Server belegt sind; dann gehört der Port in MESH_PUBLIC_URL
# (https://<CADDY_DOMAIN>:8443).
CADDY_HTTPS_PORT=443
CADDY_HTTP_PORT=80
# Optional (nur mit Apache Superset, Profil "bi"): eigener DNS-Name für Superset. Leer bzw. nicht
# gesetzt = bi.<CADDY_DOMAIN> (z. B. bi.mesh.osp-beispiel.example.de). Nie der Name des Knotens – auch
# nicht mit anderem Port –, sonst erhielte Superset das Sitzungs-Cookie des Knotens (siehe Caddyfile).
# Der Name braucht einen DNS-Eintrag auf diesen Server (bei ACME öffentlich auflösbar).
MESH_BI_DOMAIN=

# --- Datenbank ----------------------------------------------------------------------------------
# Superuser "postgres" (nur im db-Container; für Wartung)
POSTGRES_PASSWORD=
# Schema-Eigentümer: Migrationen und Wiederherstellung (nur Dienste migrate und cli)
MESH_DB_OWNER_PASSWORD=
# Laufzeitrolle des Servers (Dienst node)
MESH_DB_APP_PASSWORD=
# Nur lesende BI-Rolle, sieht ausschließlich Schema "bi" (Superset, BI-Werkzeuge)
MESH_DB_BI_PASSWORD=
# Größe des Verbindungspools des Servers
MESH_DB_POOL_MAX=10

# --- Schlüssel ----------------------------------------------------------------------------------
# Master-Key für gespeicherte Geheimnisse (AES-256-GCM)
MESH_MASTER_KEY=
# Nur während einer Schlüsselrotation: bisheriger Master-Key (siehe docs/betrieb.md), sonst leer
MESH_MASTER_KEY_PREVIOUS=
# Schlüssel für die verschlüsselten Sicherungsdateien (*.mbk)
MESH_BACKUP_KEY=

# --- Sicherungen (Volume "backups", im Container /var/lib/osp-mesh/backups) -------------------------
# Abstand automatischer Sicherungen in Stunden (0 = keine automatischen Sicherungen)
MESH_BACKUP_INTERVAL_HOURS=24
# Anzahl aufbewahrter Sicherungen
MESH_BACKUP_RETENTION=14

# --- Netz ---------------------------------------------------------------------------------------
# Erste drei Zahlen des festen Subnetzes von Netz "frontend" (/24). Caddy erhält darin die Adresse .10;
# docker-compose.yml setzt für den Knoten MESH_TRUST_PROXY=true und MESH_TRUSTED_PROXIES=<Präfix>.10:
# Nur von dieser Adresse übernimmt der Knoten die Client-Adresse aus X-Forwarded-For; andere Dienste im
# selben Netz (z. B. Superset) können keine fremde Adresse vorgeben. Das Subnetz darf sich nicht mit
# anderen Netzen des Servers oder des OSP überschneiden. Ein zweiter Knoten auf demselben Docker-Host
# braucht ein anderes Präfix (z. B. 172.31.253) und zusätzlich einen eigenen COMPOSE_PROJECT_NAME sowie
# eigene Ports (CADDY_HTTPS_PORT, CADDY_HTTP_PORT).
FRONTEND_NET_PREFIX=172.31.252
# Name des Compose-Projekts (Präfix der Container, Volumes und Netze), Standard osp-data-mesh;
# nur für einen zweiten Knoten auf demselben Docker-Host setzen
# COMPOSE_PROJECT_NAME=osp-data-mesh-test

# --- Sonstiges ----------------------------------------------------------------------------------
# Gültigkeit einer Anmeldesitzung in Stunden (1–72)
MESH_SESSION_TTL_HOURS=12
# Erlaubte Hosts für API-Quellen (kommagetrennt, host[:port]); leer = keine API-Quellen
MESH_SOURCE_ALLOWED_HOSTS=
# Zugangsgeheimnisse (Bearer-Token, Header-Wert) von API-Quellen auch über unverschlüsseltes http://
# senden (Standard false: nur über https:// bzw. an 127.0.0.1, ::1, localhost – im Container ist das
# der Container selbst). true nur in abgeschotteten Netzen, das Geheimnis geht dann im Klartext über das
# Netz. Abrufe ohne Geheimnis sind auch über http:// möglich (Host muss in MESH_SOURCE_ALLOWED_HOSTS stehen).
MESH_SOURCE_ALLOW_INSECURE_HTTP=false
# debug | info | warn | error
MESH_LOG_LEVEL=info
MESH_TIMEZONE=Europe/Berlin
# Anzeige der BI-Verbindungsdaten in der Oberfläche (nur sinnvoll, wenn die Datenbank für
# BI-Werkzeuge erreichbar gemacht wird, siehe docs/bi.md); leer lassen, wenn nicht genutzt
MESH_BI_DB_HOST=
MESH_BI_DB_PORT=
MESH_BI_DB_NAME=
# Tag des lokal gebauten Abbilds
MESH_IMAGE_TAG=local
# Nur mit docker-compose.bi-db.yml: interne IP-Adresse, auf der PostgreSQL für BI-Werkzeuge
# (Rolle mesh_bi, nur TLS) veröffentlicht wird, und Port auf dem Server (Standard 5432); siehe docs/bi.md
BI_DB_BIND=
BI_DB_PORT=5432
# BI-Datenbankzugang dauerhaft einschalten (gilt dann für jeden docker-compose-Aufruf in diesem
# Verzeichnis, auch für Updates und Wiederherstellung):
# COMPOSE_FILE=docker-compose.yml:docker-compose.bi-db.yml

# --- Erste Administration (nur für "docker compose run --rm cli create-admin") -------------------
# Leer = Passwort wird erzeugt und einmalig ausgegeben; muss bei der ersten Anmeldung geändert werden
MESH_ADMIN_PASSWORD=

# --- Optional: Apache Superset (docker compose --profile bi …) ------------------------------------
# Geheimer Schlüssel von Superset (mind. 32 Zeichen): openssl rand -base64 42
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_EMAIL=admin@localhost
SUPERSET_ADMIN_PASSWORD=
